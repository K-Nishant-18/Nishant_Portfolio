import React from 'react';

const MarqueeTicker: React.FC = () => {
  const items = ['BACKEND ENGINEERING', 'DEVOPS', 'INFRASTRUCTURE AS CODE', 'SYSTEM DESIGN', 'CLOUD ARCHITECTURE', 'CI/CD', 'RELIABILITY', 'SCALABLE SYSTEMS'];

  const row = (keyPrefix: string) => (
    <div key={keyPrefix} className="flex shrink-0 items-center gap-10 pr-10">
      {items.map((label, i) => (
        <span key={${keyPrefix}-} className="flex items-center gap-10">
          <span className="whitespace-nowrap text-sm font-bold tracking-[0.3em] uppercase text-white/60">{label}</span>
          <span className="text-red-600">&#10022;</span>
        </span>
      ))}
    </div>
  );

  return (
    <section aria-label="technologies" className="relative z-20 overflow-hidden border-y border-white/10 bg-black/40 py-3">
      <div className="marquee-anim flex w-max">
        {row('a')}{row('b')}
      </div>
    </section>
  );
};

export default MarqueeTicker;
